// Alphaboard - Leader-based Trading Decision Platform
// PostgreSQL schema managed by Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// Stocks & Market Data
// ─────────────────────────────────────────────────────────

model Stock {
  id               String        @id @default(cuid())
  ticker           String        @unique
  name             String
  briefDescription String?
  metadataEvidenceJson Json?
  sector           String?
  industry         String?
  exchange         String?
  avgVolume        BigInt?
  marketCap        BigInt?
  tradableType     TradableType?
  isTradable       Boolean       @default(true)
  isCurated        Boolean       @default(false)
  lastSyncDate     DateTime?     @db.Date
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  dailyBars             StockDaily[]
  intradayBars          StockIntraday[]
  stages                StockStage[]
  themeStocks           ThemeStock[]
  setups                Setup[]
  swingPoints           SwingPoint[]
  dailyBases            DailyBase[]
  barEvidence           BarEvidence[]
  alerts                Alert[]
  watchlistItems        WatchlistItem[]
  leaderRuns            LeaderRun[]
  setupOutcomes         SetupOutcome[]
  timingSignals         IntradayTimingSignal[]
  leaderPeriodSnapshots MarketLeaderPeriodSnapshot[]
  focusListItems        FocusListItem[]
  themeMemberships      TickerThemeMembership[]
  recommendations       StrategyRecommendation[]
  setupScanAuditItems   SetupScanAuditItem[]
}

enum TradableType {
  STOCK
  ETF
  INDEX
  COMMODITY_PROXY
}

model StockDaily {
  id      String   @id @default(cuid())
  stockId String
  date    DateTime @db.Date
  open    Decimal  @db.Decimal(12, 4)
  high    Decimal  @db.Decimal(12, 4)
  low     Decimal  @db.Decimal(12, 4)
  close   Decimal  @db.Decimal(12, 4)
  volume  BigInt
  // Pre-computed MAs for fast screening
  sma20   Decimal? @db.Decimal(12, 4)
  sma50   Decimal? @db.Decimal(12, 4)
  sma150  Decimal? @db.Decimal(12, 4)
  sma200  Decimal? @db.Decimal(12, 4)
  ema6    Decimal? @db.Decimal(12, 4)
  ema20   Decimal? @db.Decimal(12, 4)
  rsRank  Decimal? @db.Decimal(6, 2)
  atr14   Decimal? @db.Decimal(12, 4)

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, date])
  @@index([date])
  @@index([stockId, date(sort: Desc)])
}

model StockIntraday {
  id        String   @id @default(cuid())
  stockId   String
  timestamp DateTime
  open      Decimal  @db.Decimal(12, 4)
  high      Decimal  @db.Decimal(12, 4)
  low       Decimal  @db.Decimal(12, 4)
  close     Decimal  @db.Decimal(12, 4)
  volume    BigInt
  ema6      Decimal? @db.Decimal(12, 4)
  ema20     Decimal? @db.Decimal(12, 4)

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, timestamp])
  @@index([stockId, timestamp(sort: Desc)])
}

model StockStage {
  id         String        @id @default(cuid())
  stockId    String
  date       DateTime      @db.Date
  stage      StageEnum
  category   StockCategory
  isTemplate Boolean       @default(false)
  metadata   Json?

  stock Stock @relation(fields: [stockId], references: [id])

  @@unique([stockId, date])
  @@index([date, stage])
  @@index([date, category])
}

enum StageEnum {
  STAGE_1
  STAGE_2
  STAGE_3
  STAGE_4
}

enum StockCategory {
  HOT
  FORMER_HOT
  COMMODITY
  NONE
}

// ─────────────────────────────────────────────────────────
// Index & Breadth Data
// ─────────────────────────────────────────────────────────

model IndexEntity {
  id     String @id @default(cuid())
  ticker String @unique
  name   String

  dailyBars IndexDaily[]
  snapshots MarketProxySnapshot[]
}

model IndexDaily {
  id      String   @id @default(cuid())
  indexId String
  date    DateTime @db.Date
  open    Decimal  @db.Decimal(12, 4)
  high    Decimal  @db.Decimal(12, 4)
  low     Decimal  @db.Decimal(12, 4)
  close   Decimal  @db.Decimal(12, 4)
  volume  BigInt

  index IndexEntity @relation(fields: [indexId], references: [id])

  @@unique([indexId, date])
  @@index([date])
}

model BreadthSnapshot {
  id           String   @id @default(cuid())
  date         DateTime @unique @db.Date
  naad         Decimal? @db.Decimal(10, 2)
  naa50r       Decimal? @db.Decimal(6, 2)
  naa200r      Decimal? @db.Decimal(6, 2)
  nahl         Decimal? @db.Decimal(10, 2)
  avgWeightIdx Decimal? @db.Decimal(12, 4)
}

// ─────────────────────────────────────────────────────────
// Theme & Supply Chain
// ─────────────────────────────────────────────────────────

model Theme {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups           SupplyChainGroup[]
  focusListItems   FocusListItem[]
  themeMemberships TickerThemeMembership[]
  catalysts        CatalystHypothesis[]
  recommendations  StrategyRecommendation[]
}

model SupplyChainGroup {
  id        String @id @default(cuid())
  themeId   String
  name      String
  sortOrder Int    @default(0)
  layer     SupplyChainLayer?
  evidenceJson Json?

  theme            Theme                   @relation(fields: [themeId], references: [id])
  themeStocks      ThemeStock[]
  focusListItems   FocusListItem[]
  themeMemberships TickerThemeMembership[]
  catalysts        CatalystHypothesis[]
  relationshipsOut GroupRelationship[]      @relation("SourceGroup")
  relationshipsIn  GroupRelationship[]      @relation("TargetGroup")

  @@unique([themeId, name])
}

model ThemeStock {
  id      String @id @default(cuid())
  stockId String
  groupId String

  stock Stock            @relation(fields: [stockId], references: [id])
  group SupplyChainGroup @relation(fields: [groupId], references: [id])

  @@unique([stockId, groupId])
}

// ─────────────────────────────────────────────────────────
// Swing Points (foundational S/R)
// ─────────────────────────────────────────────────────────

model SwingPoint {
  id        String    @id @default(cuid())
  stockId   String
  type      SwingType
  timeframe Timeframe
  price     Decimal   @db.Decimal(12, 4)
  barDate   DateTime
  absValue  Decimal   @db.Decimal(12, 4)
  lookahead Int       @default(10)
  createdAt DateTime  @default(now())

  stock Stock @relation(fields: [stockId], references: [id])

  @@index([stockId, timeframe, type])
  @@index([stockId, barDate])
}

enum SwingType {
  HIGH
  LOW
}

enum Timeframe {
  DAILY
  INTRADAY
}

// ─────────────────────────────────────────────────────────
// Daily Bases
// ─────────────────────────────────────────────────────────

model DailyBase {
  id           String     @id @default(cuid())
  stockId      String
  peakPrice    Decimal    @db.Decimal(12, 4)
  peakDate     DateTime   @db.Date
  baseLow      Decimal    @db.Decimal(12, 4)
  retracePct   Decimal    @db.Decimal(6, 4)
  durationDays Int
  pivotPrice   Decimal?   @db.Decimal(12, 4)
  status       BaseStatus @default(FORMING)
  detectedAt   DateTime   @default(now())

  stock Stock @relation(fields: [stockId], references: [id])

  @@index([stockId, status])
}

enum BaseStatus {
  FORMING
  COMPLETE
  BROKEN_OUT
  FAILED
}

// ─────────────────────────────────────────────────────────
// Setup Detection (with state machine)
// ─────────────────────────────────────────────────────────

model Setup {
  id          String     @id @default(cuid())
  stockId     String
  type        SetupType
  timeframe   Timeframe
  direction   Direction
  state       SetupState @default(BUILDING)
  detectedAt  DateTime   @default(now())
  expiresAt   DateTime?
  lastStateAt DateTime   @default(now())

  pivotPrice  Decimal? @db.Decimal(12, 4)
  stopPrice   Decimal? @db.Decimal(12, 4)
  targetPrice Decimal? @db.Decimal(12, 4)
  riskReward  Decimal? @db.Decimal(6, 2)

  evidence    Json?
  waitingFor  String?
  metadata    Json?
  dailyBaseId String?

  stock         Stock                  @relation(fields: [stockId], references: [id])
  tradeIdeas    TradeIdea[]
  barEvidence   BarEvidence[]
  outcomes      SetupOutcome[]
  timingSignals IntradayTimingSignal[]

  @@index([state, type])
  @@index([timeframe, state])
  @@index([detectedAt])
  @@index([stockId, state])
}

enum SetupType {
  // Daily setups
  VCP
  BREAKOUT_PIVOT
  BREAKOUT_VCB
  BREAKOUT_WEDGE
  FAIL_BREAKOUT
  FAIL_BASE
  HIGH_TIGHT_FLAG
  PULLBACK_BUY
  UNDERCUT_RALLY
  DOUBLE_TOP
  MA_TOUCH // kept for backward compat (existing DB rows)
  EMA20_PULLBACK
  MA_RALLY_FAILURE
  EMA200_KEY_LEVEL
  // Intraday setups
  INTRADAY_BASE
  CROSS_620
  GAP_UP
  GAP_DOWN
  TIRING_DOWN
}

enum Direction {
  LONG
  SHORT
}

enum SetupState {
  BUILDING
  READY
  TRIGGERED
  VIOLATED
  EXPIRED
}

// ─────────────────────────────────────────────────────────
// Bar Evidence (Confirmation & Violation)
// ─────────────────────────────────────────────────────────

model BarEvidence {
  id            String          @id @default(cuid())
  stockId       String
  timeframe     Timeframe
  barDate       DateTime
  pattern       EvidencePattern
  bias          EvidenceBias
  isViolation   Boolean         @default(false)
  keyLevelType  KeyLevelType
  keyLevelPrice Decimal         @db.Decimal(12, 4)
  volumeState   VolumeState
  setupId       String?
  createdAt     DateTime        @default(now())

  stock Stock  @relation(fields: [stockId], references: [id])
  setup Setup? @relation(fields: [setupId], references: [id])

  @@index([stockId, timeframe, barDate])
  @@index([setupId])
}

enum EvidencePattern {
  DRY_UP
  LOWER_WICK_ABSORPTION
  BULLISH_ENGULFING
  RESISTANCE_DRY_UP
  UPPER_WICK_REJECTION
  BEARISH_ENGULFING
  SUPPORT_BROKEN
  PIVOT_BROKEN
  RESISTANCE_RECLAIMED
}

enum EvidenceBias {
  BULLISH
  BEARISH
}

enum VolumeState {
  EXPANSION
  CONTRACTION
  NORMAL
}

enum KeyLevelType {
  SWING_HIGH
  SWING_LOW
  BASE_LOW
  BASE_HIGH
  VCP_PIVOT
  MA_20
  MA_50
  MA_200
  VWAP
}

enum SetupFamily {
  REVERSAL
  TREND_LONG
  TREND_SHORT
}

enum SetupOutcomeSource {
  LIVE
  SIMULATED
}

enum MarketTrendLabel {
  UPTREND
  DOWNTREND
  RANGE
  TRANSITION
}

enum MarketRegimeLabel {
  TREND_UP
  TREND_DOWN
  RANGE
  TRANSITION
}

enum MarketPeriodGranularity {
  REGIME
  MONTH
  YEAR
}

enum LeaderPeriodActivity {
  ADVANCING
  SETTING_UP
  PULLBACK
  REVERSAL
  BASING
  DECLINING
  QUIET
}

enum TimingSignalType {
  CROSS_620
  MACD_620_SHORT
  VCP_EARLY_BUY
  DOUBLE_TOP_REJECTION
  DOUBLE_BOTTOM_REJECTION
}

// ─────────────────────────────────────────────────────────
// Trade Lifecycle (5 stages)
// ─────────────────────────────────────────────────────────

model TradeIdea {
  id          String          @id @default(cuid())
  userId      String?
  setupId     String?
  stockId     String
  direction   Direction
  bias        Bias
  entryPrice  Decimal?        @db.Decimal(12, 4)
  stopPrice   Decimal         @db.Decimal(12, 4)
  targetPrice Decimal?        @db.Decimal(12, 4)
  riskPercent Decimal         @db.Decimal(4, 2)
  riskReward  Decimal?        @db.Decimal(6, 2)
  status      TradeIdeaStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  notes       String?

  user   User?        @relation(fields: [userId], references: [id])
  setup  Setup?       @relation(fields: [setupId], references: [id])
  intent TradeIntent?

  @@index([userId, status])
}

model TradeIntent {
  id          String   @id @default(cuid())
  tradeIdeaId String   @unique
  confirmedAt DateTime @default(now())

  tradeIdea TradeIdea @relation(fields: [tradeIdeaId], references: [id])
  orders    Order[]
}

model Order {
  id            String      @id @default(cuid())
  intentId      String
  brokerOrderId String?
  type          OrderType
  side          Direction
  quantity      Decimal     @db.Decimal(12, 4)
  limitPrice    Decimal?    @db.Decimal(12, 4)
  stopPrice     Decimal?    @db.Decimal(12, 4)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  intent     TradeIntent @relation(fields: [intentId], references: [id])
  executions Execution[]
}

model Execution {
  id         String   @id @default(cuid())
  orderId    String
  price      Decimal  @db.Decimal(12, 4)
  quantity   Decimal  @db.Decimal(12, 4)
  fee        Decimal? @db.Decimal(12, 4)
  executedAt DateTime @default(now())

  order      Order     @relation(fields: [orderId], references: [id])
  position   Position? @relation(fields: [positionId], references: [id])
  positionId String?
}

model Position {
  id            String         @id @default(cuid())
  userId        String?
  ticker        String
  direction     Direction
  quantity      Decimal        @db.Decimal(12, 4)
  avgEntry      Decimal        @db.Decimal(12, 4)
  currentStop   Decimal?       @db.Decimal(12, 4)
  realizedPnl   Decimal        @default(0) @db.Decimal(12, 4)
  unrealizedPnl Decimal        @default(0) @db.Decimal(12, 4)
  status        PositionStatus @default(OPEN)
  openedAt      DateTime       @default(now())
  closedAt      DateTime?

  executions Execution[]

  @@index([userId, status])
}

enum TradeIdeaStatus {
  PENDING
  CONFIRMED
  SKIPPED
  EXPIRED
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
}

enum OrderStatus {
  PENDING
  SUBMITTED
  PARTIAL
  FILLED
  CANCELLED
  REJECTED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum Bias {
  BULLISH
  BEARISH
  BOTH
}

// ─────────────────────────────────────────────────────────
// User & Preferences
// ─────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  preferences UserPreference?
  watchlists  Watchlist[]
  alerts      Alert[]
  tradeIdeas  TradeIdea[]
  sessions    Session[]
  accounts    Account[]
}

// ─────────────────────────────────────────────────────────
// Better Auth: Session, Account, Verification
// ─────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserPreference {
  id             String      @id @default(cuid())
  userId         String      @unique
  defaultRiskPct Decimal     @default(0.5) @db.Decimal(4, 2)
  riskProfile    RiskProfile @default(NORMAL)

  user User @relation(fields: [userId], references: [id])
}

enum RiskProfile {
  CONSERVATIVE
  NORMAL
  AGGRESSIVE
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id])
  items WatchlistItem[]

  @@unique([userId, name])
}

model WatchlistItem {
  id          String @id @default(cuid())
  watchlistId String
  stockId     String

  watchlist Watchlist @relation(fields: [watchlistId], references: [id])
  stock     Stock     @relation(fields: [stockId], references: [id])

  @@unique([watchlistId, stockId])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  stockId     String?
  type        AlertType
  condition   Json
  isTriggered Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id])
  stock Stock? @relation(fields: [stockId], references: [id])
}

enum AlertType {
  PRICE_LEVEL
  EMA_CROSS_620
  SETUP_DETECTED
  GROUP_CROSS
  STAGE_CHANGE
}

model LeaderRun {
  id              String   @id @default(cuid())
  stockId         String
  stage2StartDate DateTime @db.Date
  stage2EndDate   DateTime @db.Date
  entryPrice      Decimal  @db.Decimal(12, 4)
  peakPrice       Decimal  @db.Decimal(12, 4)
  peakGainPct     Decimal  @db.Decimal(8, 2)
  isQualified     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stock           Stock                        @relation(fields: [stockId], references: [id])
  periodSnapshots MarketLeaderPeriodSnapshot[]

  @@index([stockId, stage2StartDate])
  @@index([isQualified, stage2StartDate])
}

model SetupOutcome {
  id              String             @id @default(cuid())
  setupId         String?
  stockId         String?
  source          SetupOutcomeSource
  family          SetupFamily
  setupType       SetupType
  direction       Direction
  effectiveDate   DateTime           @db.Date
  detectedAt      DateTime
  entryDate       DateTime?
  exitDate        DateTime?
  actualStopPrice Decimal?           @db.Decimal(12, 4)
  entryPrice      Decimal?           @db.Decimal(12, 4)
  exitPrice       Decimal?           @db.Decimal(12, 4)
  maxR            Decimal?           @db.Decimal(8, 2)
  finalR          Decimal?           @db.Decimal(8, 2)
  isWin           Boolean?
  sampleCount     Int                @default(1)
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  setup Setup? @relation(fields: [setupId], references: [id])
  stock Stock? @relation(fields: [stockId], references: [id])

  @@index([effectiveDate, source, family])
  @@index([stockId, effectiveDate])
  @@index([setupId])
}

model IntradayTimingSignal {
  id             String           @id @default(cuid())
  parentSetupId  String
  stockId        String
  type           TimingSignalType
  direction      Direction
  signalAt       DateTime
  levelType      KeyLevelType
  referenceLevel Decimal          @db.Decimal(12, 4)
  triggerPrice   Decimal?         @db.Decimal(12, 4)
  stopPrice      Decimal?         @db.Decimal(12, 4)
  evidence       Json?
  metadata       Json?
  createdAt      DateTime         @default(now())

  parentSetup Setup @relation(fields: [parentSetupId], references: [id])
  stock       Stock @relation(fields: [stockId], references: [id])

  @@index([parentSetupId, signalAt])
  @@index([stockId, signalAt])
}

model MarketProxySnapshot {
  id             String           @id @default(cuid())
  indexId        String
  date           DateTime         @db.Date
  close          Decimal          @db.Decimal(12, 4)
  sma50          Decimal?         @db.Decimal(12, 4)
  sma200         Decimal?         @db.Decimal(12, 4)
  stage          StageEnum
  trend          MarketTrendLabel
  dominantFamily SetupFamily?
  dominantSetup  SetupType?
  setupScore     Decimal?         @db.Decimal(8, 2)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  index IndexEntity @relation(fields: [indexId], references: [id])

  @@unique([indexId, date])
  @@index([date, trend])
}

model MarketRegimePeriod {
  id                   String                       @id @default(cuid())
  granularity          MarketPeriodGranularity      @default(REGIME)
  periodKey            String
  startDate            DateTime                     @db.Date
  endDate              DateTime                     @db.Date
  label                MarketRegimeLabel
  liveSampleCount      Int                          @default(0)
  simulatedSampleCount Int                          @default(0)
  sourcePeriodCount    Int                          @default(1)
  scorecard            Json
  proxyStates          Json
  leaderSummary        Json
  markdown             String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  leaderSnapshots      MarketLeaderPeriodSnapshot[]

  @@unique([granularity, periodKey])
  @@index([startDate, endDate])
  @@index([granularity, startDate])
  @@index([label, startDate])
}

// ─────────────────────────────────────────────────────────
// Research Workflow: Scan Runs (timing + cost instrumentation)
// ─────────────────────────────────────────────────────────

model ScanRun {
  id                String        @id @default(cuid())
  type              ScanRunType
  status            ScanRunStatus @default(RUNNING)
  startedAt         DateTime      @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  stockCount        Int?
  candidateCount    Int?
  focusListCount    Int?
  modelInputTokens  Int?
  modelOutputTokens Int?
  modelCostEstimate Decimal?      @db.Decimal(12, 6)
  stepTimingsJson   Json?
  error             String?
  notes             String?
  createdAt         DateTime      @default(now())

  focusLists      FocusList[]
  setupAuditRuns  SetupScanAuditRun[]

  @@index([type, startedAt(sort: Desc)])
  @@index([status])
}

model SetupScanAuditRun {
  id          String             @id @default(cuid())
  scanRunId   String?
  status      ScanRunStatus      @default(RUNNING)
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  stockCount  Int                @default(0)
  inputCount  Int                @default(0)
  candidateCount Int             @default(0)
  detectedCount  Int             @default(0)
  focusIncludedCount Int         @default(0)
  error       String?
  notes       String?
  createdAt   DateTime           @default(now())

  scanRun ScanRun?              @relation(fields: [scanRunId], references: [id])
  items   SetupScanAuditItem[]

  @@index([startedAt(sort: Desc)])
  @@index([scanRunId])
  @@index([status])
}

model SetupScanAuditItem {
  id              String               @id @default(cuid())
  auditRunId      String
  stockId         String
  ticker          String
  name            String?
  sector          String?
  industry        String?
  stage           StageEnum?
  category        StockCategory?
  latestClose     Decimal?             @db.Decimal(12, 4)
  avgVolume       BigInt?
  scanStatus      SetupScanAuditStatus
  focusStatus     SetupScanFocusStatus @default(NOT_EVALUATED)
  reasonCodesJson Json
  reasonText      String?
  setupTypesText  String?
  detectedSetupsJson Json?
  modelReviewIdsJson Json?
  focusReason     FocusReason?
  setupBias       SetupBias?
  priorityScore   Decimal?             @db.Decimal(6, 2)
  identifiedSetupJson Json?
  error           String?
  scannedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  auditRun SetupScanAuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  stock    Stock             @relation(fields: [stockId], references: [id])

  @@unique([auditRunId, stockId])
  @@index([auditRunId, scanStatus])
  @@index([auditRunId, focusStatus])
  @@index([ticker])
  @@index([setupTypesText])
  @@index([stockId])
}

// ─────────────────────────────────────────────────────────
// Research Workflow: Focus Lists
// ─────────────────────────────────────────────────────────

model FocusList {
  id                        String        @id @default(cuid())
  name                      String
  type                      FocusListType
  createdAt                 DateTime      @default(now())
  expiresAt                 DateTime?
  sourceScanRunId           String?
  // Forward references (tables added in later phases). Plain ids for now.
  marketConditionSnapshotId String?
  notes                     String?

  sourceScanRun ScanRun?        @relation(fields: [sourceScanRunId], references: [id])
  items         FocusListItem[]

  @@index([type, createdAt(sort: Desc)])
}

model FocusListItem {
  id                     String              @id @default(cuid())
  focusListId            String
  stockId                String
  themeId                String?
  groupId                String?
  reason                 FocusReason
  priorityScore          Decimal?            @db.Decimal(6, 2)
  setupBias              SetupBias           @default(WATCH)
  expectedSetupTypesJson Json?
  keyLevelsJson          Json?
  invalidationLevelsJson Json?
  identifiedSetupJson    Json?
  // Forward reference (CatalystHypothesis added in a later phase).
  catalystHypothesisId   String?
  focusToday             Boolean             @default(false)
  focusTodayReason       String?
  status                 FocusListItemStatus @default(ACTIVE)
  addedAt                DateTime            @default(now())
  lastReviewedAt         DateTime?

  focusList FocusList         @relation(fields: [focusListId], references: [id], onDelete: Cascade)
  stock     Stock             @relation(fields: [stockId], references: [id])
  theme     Theme?            @relation(fields: [themeId], references: [id])
  group     SupplyChainGroup? @relation(fields: [groupId], references: [id])

  @@unique([focusListId, stockId])
  @@index([status])
  @@index([focusToday])
}

enum FocusListType {
  WEEKLY
  MIDWEEK
  THEME
  MANUAL
}

enum SetupBias {
  LONG
  SHORT
  BOTH
  WATCH
}

enum FocusListItemStatus {
  ACTIVE
  TRIGGERED
  VIOLATED
  EXPIRED
  REMOVED
}

enum FocusReason {
  STRONG_DAILY_SETUP
  GROUP_SYNCHRONIZED
  CATALYST_HYPOTHESIS
  CURRENT_LEADER
  PREVIOUS_LEADER_KEY_LEVEL
  REVERSAL_620_ZONE
  MANUAL_PIN
}

enum ScanRunType {
  FULL_SCAN
  FOCUS_UPDATE
  MODEL_REVIEW
  VISUAL_REVIEW
}

enum ScanRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SetupScanAuditStatus {
  INPUT_FILTERED
  CANDIDATE
  INSUFFICIENT_DATA
  NO_SETUP
  DETECTED
  DEDUPED
  SUPPRESSED
  ERROR
}

enum SetupScanFocusStatus {
  NOT_EVALUATED
  INCLUDED
  EXCLUDED
}

model MarketLeaderPeriodSnapshot {
  id                    String               @id @default(cuid())
  marketRegimePeriodId  String
  leaderRunId           String
  stockId               String
  periodStartDate       DateTime             @db.Date
  periodEndDate         DateTime             @db.Date
  stageAtPeriodStart    StageEnum?
  stageAtPeriodEnd      StageEnum?
  activity              LeaderPeriodActivity
  activityNote          String?
  identifiedSetupLabel  String?
  primarySetupType      SetupType?
  primarySetupDirection Direction?
  primarySetupState     SetupState?
  setupCount            Int                  @default(0)
  activeSetups          Json
  timingSignalCount     Int                  @default(0)
  timingSignals         Json
  startClose            Decimal?             @db.Decimal(12, 4)
  endClose              Decimal?             @db.Decimal(12, 4)
  periodReturnPct       Decimal?             @db.Decimal(8, 2)
  shortingEnabled       Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  period    MarketRegimePeriod @relation(fields: [marketRegimePeriodId], references: [id])
  leaderRun LeaderRun          @relation(fields: [leaderRunId], references: [id])
  stock     Stock              @relation(fields: [stockId], references: [id])

  @@unique([marketRegimePeriodId, leaderRunId])
  @@index([stockId, periodStartDate])
  @@index([activity, periodStartDate])
}

// ─────────────────────────────────────────────────────────
// Research Workflow: Ticker/Theme Metadata & Group Relationships
// ─────────────────────────────────────────────────────────

model TickerThemeMembership {
  id              String   @id @default(cuid())
  stockId         String
  themeId         String
  groupId         String?
  roleDescription String?
  importanceScore Decimal? @db.Decimal(4, 3)
  isPrimaryTheme  Boolean  @default(false)
  source          String?
  evidenceJson    Json?
  reviewedAt      DateTime @default(now())

  stock Stock             @relation(fields: [stockId], references: [id])
  theme Theme             @relation(fields: [themeId], references: [id])
  group SupplyChainGroup? @relation(fields: [groupId], references: [id])

  @@unique([stockId, themeId])
  @@index([themeId])
}

model GroupRelationship {
  id               String              @id @default(cuid())
  sourceGroupId    String
  targetGroupId    String
  relationshipType RelationshipType
  macroSensitivity MacroSensitivity?
  eventCategory    String?
  strengthScore    Decimal?            @db.Decimal(4, 3)
  lagDaysEstimate  Int?
  source           String?
  notes            String?
  evidenceJson     Json?
  createdAt        DateTime            @default(now())

  sourceGroup SupplyChainGroup @relation("SourceGroup", fields: [sourceGroupId], references: [id])
  targetGroup SupplyChainGroup @relation("TargetGroup", fields: [targetGroupId], references: [id])

  @@unique([sourceGroupId, targetGroupId, relationshipType])
  @@index([sourceGroupId])
  @@index([targetGroupId])
}

enum RelationshipType {
  LEADS
  LAGS
  BENEFITS
  HURTS
  COMPETES
  SUPPLIER_TO
}

enum MacroSensitivity {
  RATES
  DOLLAR
  OIL
  COPPER
  GOLD
  YIELDS
  INFLATION
}

enum SupplyChainLayer {
  INPUT
  EQUIPMENT
  COMPONENT
  INFRASTRUCTURE
  PLATFORM
  APPLICATION
  DISTRIBUTION
  END_MARKET
  FINANCING
}

// ─────────────────────────────────────────────────────────
// Research Workflow: Catalyst Hypotheses
// ─────────────────────────────────────────────────────────

model CatalystHypothesis {
  id                       String         @id @default(cuid())
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  themeId                  String?
  groupId                  String?
  title                    String
  hypothesis               String
  sourceUrlsJson           Json?
  evidenceJson             Json?
  expectedBeneficiariesJson Json?
  expectedLosersJson       Json?
  technicalVerificationJson Json?
  status                   CatalystStatus @default(WATCHING)
  confidenceScore          Decimal?       @db.Decimal(4, 3)

  theme           Theme?                   @relation(fields: [themeId], references: [id])
  group           SupplyChainGroup?        @relation(fields: [groupId], references: [id])
  recommendations StrategyRecommendation[]

  @@index([status, createdAt(sort: Desc)])
}

enum CatalystStatus {
  WATCHING
  CONFIRMED
  REJECTED
  STALE
}

// ─────────────────────────────────────────────────────────
// Research Workflow: Market Condition Snapshot
// ─────────────────────────────────────────────────────────

model MarketConditionSnapshot {
  id        String          @id @default(cuid())
  date      DateTime        @db.Date
  scopeType MarketScopeType
  scopeKey  String

  // Long-term trend
  longTermTrendingUp   Boolean @default(false)
  longTermTrendingDown Boolean @default(false)
  longTermRanging      Boolean @default(false)
  longTermRangeHigh    Decimal? @db.Decimal(12, 4)
  longTermRangeLow     Decimal? @db.Decimal(12, 4)

  // Mid-term trend
  midTermTrendingUp   Boolean @default(false)
  midTermTrendingDown Boolean @default(false)
  midTermRanging      Boolean @default(false)
  midTermExtended     Boolean @default(false)
  midTermPullback     Boolean @default(false)

  // Short-term trend
  shortTermTrendingUp   Boolean @default(false)
  shortTermTrendingDown Boolean @default(false)
  shortTermRanging      Boolean @default(false)
  shortTermExtended     Boolean @default(false)
  shortTermOversold     Boolean @default(false)

  // Breadth
  breadthConfirming    Boolean @default(false)
  breadthDiverging     Boolean @default(false)
  breadthImproving     Boolean @default(false)
  breadthDeteriorating Boolean @default(false)

  // Leaders
  leadersAdvancing Boolean @default(false)
  leadersBasing    Boolean @default(false)
  leadersFailing   Boolean @default(false)
  leadersExtended  Boolean @default(false)
  leadersRotating  Boolean @default(false)

  // Regime character
  easyMoney     Boolean @default(false)
  quickRotation Boolean @default(false)
  hardPenny     Boolean @default(false)
  distribution  Boolean @default(false)
  earlyRecovery Boolean @default(false)

  // Favorable setup families
  breakoutFavorable   Boolean @default(false)
  pullbackFavorable   Boolean @default(false)
  reversalFavorable   Boolean @default(false)
  shortFavorable      Boolean @default(false)
  holdLongerFavorable Boolean @default(false)
  scalpOnly           Boolean @default(false)
  stayOut             Boolean @default(false)

  // Exposure
  waterTest          Boolean @default(false)
  normalExposure     Boolean @default(false)
  aggressiveExposure Boolean @default(false)
  marginAllowed      Boolean @default(false)

  // Scores
  trendScore         Decimal? @db.Decimal(5, 2)
  breadthScore       Decimal? @db.Decimal(5, 2)
  leaderScore        Decimal? @db.Decimal(5, 2)
  followThroughScore Decimal? @db.Decimal(5, 2)
  riskScore          Decimal? @db.Decimal(5, 2)
  confidenceScore    Decimal? @db.Decimal(5, 2)

  trendDetailJson          Json?
  breadthStructureJson     Json?
  equalWeightStructureJson Json?
  setupPerformanceJson     Json?
  evidenceJson Json?
  summary      String?
  createdAt    DateTime @default(now())

  @@unique([date, scopeType, scopeKey])
  @@index([scopeType, date(sort: Desc)])
}

enum MarketScopeType {
  INDEX
  LEADER_UNIVERSE
  TRADABLE_UNIVERSE
  THEME
  GROUP
}

