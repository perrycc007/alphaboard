  prompt        String?
  payloadJson   Json?
  resultJson    Json?
  createdAt     DateTime        @default(now())

  @@index([reviewType, createdAt(sort: Desc)])
  @@index([scanRunId])
}

enum ModelReviewType {
  DATAFRAME_REVIEW
  METADATA_ENRICHMENT
  CATALYST_SEARCH
  GROUP_GALLERY
  CHART_REVIEW
  STRATEGY_REPORT
}

// ─────────────────────────────────────────────────────────
// Research Workflow: Gilmo Almanac Knowledge Base
// ─────────────────────────────────────────────────────────

model AlmanacSource {
  id                 String   @id @default(cuid())
  pdfFileName        String   @unique
  title              String?
  year               Int?
  quarter            Int?
  pageCount          Int
  embeddedImageCount Int      @default(0)
  pdfPath            String
  fileSizeBytes      BigInt?
  importedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reports    AlmanacReport[]
  charts     AlmanacChart[]
  tradeCases AlmanacTradeCase[]
  doctrines  AlmanacDoctrine[]

  @@index([year, quarter])
}

model AlmanacReport {
  id                String   @id @default(cuid())
  sourceId          String
  reportDate        DateTime @db.Date
  title             String?
  pageStart         Int
  pageEnd           Int
  marketContext     String?
  tickersJson       Json?
  setupTagsJson     Json?
  catalystTagsJson  Json?
  mindsetTagsJson   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  source     AlmanacSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  charts     AlmanacChart[]
  tradeCases AlmanacTradeCase[]
  doctrines  AlmanacDoctrine[]

  @@unique([sourceId, reportDate, pageStart])
  @@index([reportDate])
  @@index([sourceId, pageStart])
}

model AlmanacChart {
  id                 String                  @id @default(cuid())
  sourceId           String
  reportId           String?
  pageNumber         Int
  imageNumber        Int
  imagePath          String?
  chartType          String?
  width              Int?
  height             Int?
  inferredTicker     String?
  inferredSetupTags  Json?
  nearbyTextSnippet  String?
  sourceConfidence   AlmanacSourceConfidence @default(LOW)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  source     AlmanacSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  report     AlmanacReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  tradeCases AlmanacTradeCase[]

  @@unique([sourceId, imageNumber])
  @@index([sourceId, pageNumber])
  @@index([inferredTicker])
}

model AlmanacTradeCase {
  id                 String                  @id @default(cuid())
  sourceId           String
  reportId           String?
  chartId            String?
  ticker             String
  setupTag           String
  direction          Direction?
  phase              AlmanacSetupPhase       @default(REFERENCE)
  keyLevelsJson      Json?
  catalystTagsJson   Json?
  mindsetTagsJson    Json?
  timeframeStart     DateTime?               @db.Date
  timeframeEnd       DateTime?               @db.Date
  sourcePage         Int
  sourceExcerpt      String?
  sourceConfidence   AlmanacSourceConfidence @default(LOW)
  label              AlmanacTradeLabel       @default(UNCLEAR)
  reviewNotes        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  source AlmanacSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  report AlmanacReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  chart  AlmanacChart?  @relation(fields: [chartId], references: [id], onDelete: SetNull)

  @@unique([sourceId, sourcePage, ticker, setupTag])
  @@index([ticker])
  @@index([setupTag])
  @@index([label])
  @@index([sourcePage])
}

model AlmanacDoctrine {
  id                 String                  @id @default(cuid())
  sourceId           String?
  reportId           String?
  title              String
  summary            String
  setupTagsJson      Json?
  mindsetTagsJson    Json?
  catalystTagsJson   Json?
  sourcePage         Int?
  sourceExcerpt      String?
  sourceConfidence   AlmanacSourceConfidence @default(MEDIUM)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  source AlmanacSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  report AlmanacReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([title])
  @@index([sourcePage])
}

enum AlmanacSourceConfidence {
  HIGH
  MEDIUM
  LOW
}

enum AlmanacSetupPhase {
  APPROACHING
  TOUCHED
  TRIGGERED
  FAILED
  NEGATIVE
  REFERENCE
}

enum AlmanacTradeLabel {
  VALID
  UNCLEAR
  FALSE_POSITIVE
  REFERENCE_ONLY
}

// ─────────────────────────────────────────────────────────
// Research Workflow: Strategy Recommendations & Outcomes
// ─────────────────────────────────────────────────────────

model StrategyRecommendation {
  id                        String       @id @default(cuid())
  date                      DateTime     @db.Date
  stockId                   String
  themeId                   String?
  groupId                   String?
  setupType                 SetupType?
  direction                 Direction
  entryZoneJson             Json?
  stopLevel                 Decimal?     @db.Decimal(12, 4)
  targetLevelsJson          Json?
  exitPlanJson              Json?
  thesis                    String?
  catalystHypothesisId      String?
  marketConditionSnapshotId String?
  confidenceScore           Decimal?     @db.Decimal(5, 2)
  exposureMode              ExposureMode @default(NORMAL)
  createdAt                 DateTime     @default(now())

  stock     Stock               @relation(fields: [stockId], references: [id])
  theme     Theme?              @relation(fields: [themeId], references: [id])
  catalyst  CatalystHypothesis? @relation(fields: [catalystHypothesisId], references: [id])
  outcome   RecommendationOutcome?

  @@index([date(sort: Desc)])
  @@index([stockId, date(sort: Desc)])
}

model RecommendationOutcome {
  id               String   @id @default(cuid())
  recommendationId String   @unique
  maxR             Decimal? @db.Decimal(8, 2)
  maxPctMove       Decimal? @db.Decimal(8, 2)
  finalR           Decimal? @db.Decimal(8, 2)
  daysToMaxR       Int?
  stoppedOut       Boolean  @default(false)
  targetHit        Boolean  @default(false)
  setupViolated    Boolean  @default(false)
  bestExitSignal   String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recommendation StrategyRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

enum ExposureMode {
  STAY_OUT
  WATER_TEST
  NORMAL
  AGGRESSIVE
  MARGIN_ALLOWED
}
