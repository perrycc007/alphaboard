# Database
DATABASE_URL="postgresql://alphaboard:alphaboard@localhost:7777/alphaboard?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Polygon.io (for intraday data)
POLYGON_API_KEY=
POLYGON_WS_URL=wss://socket.polygon.io
POLYGON_REST_URL=https://api.polygon.io

# DeepSeek (text reasoning: dataframe/metadata/catalyst/report)
# Keep real keys only in backend/.env. Do not commit secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TEXT_MODEL=deepseek-chat
DEEPSEEK_COST_PER_1K_INPUT=0.00027
DEEPSEEK_COST_PER_1K_OUTPUT=0.0011

# Alibaba Model Studio / DashScope / Qwen (vision: chart/group review)
# Keep real keys only in backend/.env. Do not commit secrets.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-eoudlg0xiwynadnr.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_URL=https://ws-eoudlg0xiwynadnr.ap-southeast-1.maas.aliyuncs.com/api/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_TRIAGE_MODEL=qwen3-vl-flash
QWEN_VISION_DEEP_MODEL=qwen3-vl-plus
QWEN_VISION_FALLBACK_MODEL=qwen-vl-max-latest
QWEN_COST_PER_1K_INPUT=0.0004
QWEN_COST_PER_1K_OUTPUT=0.0012

# Telegram labeling bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Full-scan model review limits (DeepSeek text pass over the fresh focus list).
# Set either to 0 to skip that step during a full scan.
RESEARCH_ENRICH_LIMIT=25
RESEARCH_CATALYST_LIMIT=8
# Skip Yahoo daily + index backfill during full scan (bars already fresh)
PIPELINE_SKIP_BACKFILL=false

# Data ingestion pipeline controls
# Set to true only when you want startup/cron pipeline sync to run.
ENABLE_PIPELINE_SYNC=false
# Set to true only when you want the weekday daily sync cron to run.
ENABLE_DAILY_SYNC_CRON=false
